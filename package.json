{
  "name": "@iden3/biome-config",
  "version": "2.0.0",
  "description": "Shared Biome configuration (formatter + linter) for iden3 projects",
  "type": "module",
  "exports": {
    "./biome": "./biome.json"
  },
  "files": [
    "biome.json"
  ],
  "author": "Iden3 Core team",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/iden3/eslint-config"
  },
  "keywords": [
    "iden3",
    "biome",
    "config"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/iden3/eslint-config/issues"
  },
  "scripts": {
    "format": "biome format --write .",
    "check": "biome check --write .",
    "lint": "biome ci . && cspell \"**/*.{ts,js,mjs,json,md}\" --no-progress --no-must-find-files",
    "publish-manual": "npm publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "cspell": "^10.0.1"
  }
}
